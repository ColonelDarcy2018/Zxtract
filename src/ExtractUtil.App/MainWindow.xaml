<Window x:Class="ExtractUtil.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ExtractUtil - 智能批量解压"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        Background="#F4F7FB"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        AllowDrop="True"
        PreviewDragOver="OnPreviewDragOver"
        Drop="OnDrop"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding AddFilesCommand}" />
        <KeyBinding Key="F5" Command="{Binding StartCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding ScanOnlyCommand}" />
        <KeyBinding Key="E" Modifiers="Control+Shift" Command="{Binding ExportLogCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1E40AF" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#172033" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5F6B7A" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#8A94A3" />
        <SolidColorBrush x:Key="BorderBrush" Color="#DCE3ED" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
        <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F7F9FC" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#B8C4D4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EEF2F7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryPressedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IdleButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IdlePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#FEF3F2" />
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="#F7C9C5" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SelectionBrush" Value="#9EC5FE" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4" />
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Padding" Value="10,5" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF1F6" />
            <Setter Property="RowBackground" Value="#FFFFFF" />
            <Setter Property="AlternatingRowBackground" Value="#FAFCFE" />
            <Setter Property="RowHeight" Value="44" />
            <Setter Property="ColumnHeaderHeight" Value="40" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F7F9FC" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="#E6EBF2" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="GridTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
        </Style>

        <Style x:Key="SummaryValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SummaryLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="WorkflowTabItemStyle" TargetType="TabItem">
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Margin="1"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#E8EEF8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="TabBorder" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#D6E3F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkflowTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Padding="3" Background="#F1F5F9" CornerRadius="9">
                                <TabPanel IsItemsHost="True" />
                            </Border>
                            <ContentPresenter Grid.Row="1"
                                              Margin="0,16,0,0"
                                              ContentSource="SelectedContent"
                                              KeyboardNavigation.TabNavigation="Local" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0"
              Height="31"
              Padding="6,0"
              Background="#FFFFFF"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,0,1">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="添加压缩文件..." Command="{Binding AddFilesCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="开始文件解压" Command="{Binding StartCommand}" InputGestureText="F5" />
                <Separator />
                <MenuItem Header="仅扫描文件夹" Command="{Binding ScanOnlyCommand}" InputGestureText="Ctrl+S" />
                <Separator />
                <MenuItem Header="导出日志..." Command="{Binding ExportLogCommand}" InputGestureText="Ctrl+Shift+E" />
            </MenuItem>
            <MenuItem Header="资源管理器(_E)">
                <MenuItem Header="注册右键菜单" Command="{Binding RegisterContextMenuCommand}" />
                <MenuItem Header="卸载右键菜单" Command="{Binding UnregisterContextMenuCommand}" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1"
                Margin="16,14,16,10"
                Padding="18,15"
                Background="#FFFFFF"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Text="智能批量解压" />
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{StaticResource PrimaryBrush}" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding OverallStatus, FallbackValue=就绪, TargetNullValue=就绪}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button MinWidth="92"
                            Margin="0,0,8,0"
                            Command="{Binding PauseResumeCommand}"
                            Content="{Binding PauseButtonText, FallbackValue=暂停, TargetNullValue=暂停}"
                            IsEnabled="{Binding CanPause}"
                            Style="{StaticResource BaseButtonStyle}"
                            ToolTip="用于文件夹自动解压：暂停派发新任务；正在运行的任务完成后进入暂停状态。" />
                    <Button MinWidth="82" Command="{Binding CancelCommand}" Content="取消" IsEnabled="{Binding IsBusy}" Style="{StaticResource DangerButtonStyle}" />
                </StackPanel>

                <ProgressBar Grid.Row="1"
                             Grid.ColumnSpan="2"
                             Height="3"
                             Margin="0,13,0,-15"
                             BorderThickness="0"
                             Foreground="{StaticResource PrimaryBrush}"
                             Background="#E9EFF7"
                             IsIndeterminate="{Binding IsBusy}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="16,0,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="300" />
                <RowDefinition Height="8" />
                <RowDefinition Height="190" MinHeight="110" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="300" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="650" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <StackPanel Margin="0,0,2,0">
                    <Border Margin="0,0,0,10" Style="{StaticResource CardStyle}">
                        <TabControl SelectedIndex="{Binding SelectedWorkflowIndex}"
                                    Style="{StaticResource WorkflowTabControlStyle}">
                            <TabItem Header="普通文件解压" Style="{StaticResource WorkflowTabItemStyle}">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Text="解压一个或多个文件" />
                                    <TextBlock Margin="0,5,0,12"
                                               Style="{StaticResource HintTextStyle}"
                                               Text="适合临时解压单个压缩包。文件会加入右侧任务列表，不会递归扫描其内部压缩文件。" />

                                    <Border Margin="0,0,0,12" Padding="11,9" Background="#F7F9FC" CornerRadius="7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="待处理文件" />
                                            <TextBlock Grid.Column="1" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Text="{Binding DirectFileStatus}" />
                                        </Grid>
                                    </Border>

                                    <Button Margin="0,0,0,8"
                                            Command="{Binding AddFilesCommand}"
                                            Content="添加压缩文件..."
                                            Style="{StaticResource IdleButtonStyle}" />
                                    <Button Command="{Binding StartCommand}"
                                            Content="开始文件解压"
                                            Style="{StaticResource IdlePrimaryButtonStyle}"
                                            ToolTip="解压通过“添加压缩文件”加入的待处理文件（F5）" />
                                    <TextBlock Margin="0,8,0,0"
                                               Style="{StaticResource HintTextStyle}"
                                               Text="失败或取消后，可在右侧选中任务并直接重试，无需重新选择文件。" />
                                </StackPanel>
                            </TabItem>

                            <TabItem Header="文件夹自动解压" Style="{StaticResource WorkflowTabItemStyle}">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Text="扫描并递归解压文件夹" />
                                    <TextBlock Margin="0,5,0,12"
                                               Style="{StaticResource HintTextStyle}"
                                               Text="适合批量目录、嵌套压缩包和散落在不同子目录中的分卷。" />

                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="扫描根目录" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding ScanRootDirectory, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入或选择需要扫描的根目录" />
                                        <Button Grid.Column="1" MinWidth="66" Margin="8,0,0,0" Padding="10,6" Command="{Binding BrowseScanRootCommand}" Content="浏览..." Style="{StaticResource BaseButtonStyle}" />
                                    </Grid>

                                    <CheckBox Margin="0,10,0,4" IsChecked="{Binding RecursiveExtractionEnabled}" Content="递归检测并解压嵌套压缩包" />
                                    <CheckBox IsChecked="{Binding GroupDistributedVolumes}" Content="跨目录识别并临时归并分卷" />
                                    <CheckBox IsEnabled="{Binding UseCustomOutputDirectory}"
                                              IsChecked="{Binding PreserveRelativeDirectories}"
                                              Content="自定义输出目录中保留原相对结构" />

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="88" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Margin="0" Text="最大递归层级" />
                                        <TextBox Grid.Column="1" Text="{Binding MaxScanPassesText, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" />
                                    </Grid>
                                    <TextBlock Margin="0,6,0,12" Style="{StaticResource HintTextStyle}" Text="达到层级上限、任务上限或检测到循环时自动停止。" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Command="{Binding ScanOnlyCommand}" Content="仅扫描" Style="{StaticResource IdleButtonStyle}" />
                                        <Button Grid.Column="2" Command="{Binding ScanAndExtractCommand}" Content="扫描并解压" Style="{StaticResource IdlePrimaryButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </Border>

                    <Border Margin="0,0,0,10" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="通用设置 · 密码候选" />
                            <CheckBox Margin="0,0,0,7" IsChecked="{Binding InferPasswordsFromPath}" Content="从文件夹和文件名自动推断密码" />
                            <TextBox MinHeight="78"
                                     MaxHeight="130"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding PasswordCandidatesText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="每行输入一个候选密码，排在前面的优先尝试" />
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource HintTextStyle}"
                                           Text="每行一个，按顺序尝试；密码内容不会写入日志。" />
                                <Button Grid.Column="1"
                                        MinHeight="30"
                                        Padding="10,4"
                                        Command="{Binding SaveCandidatePasswordsCommand}"
                                        Content="保存候选到密码库"
                                        Style="{StaticResource BaseButtonStyle}" />
                            </Grid>

                            <Separator Margin="0,12,0,8" Background="#E8EDF4" />

                            <Expander Header="自定义推断规则">
                                <StackPanel Margin="0,8,0,2">
                                    <TextBlock Margin="0,0,0,7"
                                               Style="{StaticResource HintTextStyle}"
                                               Text="内置的“解压密码 / 密码 / p / pass / pwd”规则始终保留。每行可追加一个模板，必须包含 {password}，例如：提取码：{password}" />
                                    <TextBox MinHeight="66"
                                             MaxHeight="120"
                                             AcceptsReturn="True"
                                             VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto"
                                             Text="{Binding CustomPasswordRulesText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="每行一条，例如：口令={password}" />
                                    <Button Margin="0,8,0,0"
                                            MinHeight="32"
                                            Command="{Binding SavePasswordRulesCommand}"
                                            Content="保存推断规则到本机"
                                            Style="{StaticResource BaseButtonStyle}" />
                                </StackPanel>
                            </Expander>

                            <Expander Margin="0,8,0,0" Header="本地密码库">
                                <StackPanel Margin="0,8,0,2">
                                    <ListBox MaxHeight="150"
                                             Margin="0,0,0,8"
                                             ItemsSource="{Binding SavedPasswords}"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             BorderThickness="1">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="4,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding MaskedValue}" />
                                                    <Button Grid.Column="1"
                                                            MinHeight="28"
                                                            Margin="6,0,5,0"
                                                            Padding="9,3"
                                                            Command="{Binding DataContext.UseSavedPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="使用"
                                                            Style="{StaticResource BaseButtonStyle}" />
                                                    <Button Grid.Column="2"
                                                            MinHeight="28"
                                                            Padding="9,3"
                                                            Command="{Binding DataContext.DeleteSavedPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="删除"
                                                            Style="{StaticResource DangerButtonStyle}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding NewSavedPassword, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="输入一个要保存到本机密码库的密码" />
                                        <Button Grid.Column="1"
                                                MinWidth="68"
                                                Margin="7,0,0,0"
                                                Command="{Binding AddSavedPasswordCommand}"
                                                Content="保存"
                                                Style="{StaticResource BaseButtonStyle}" />
                                    </Grid>
                                    <TextBlock Margin="0,7,0,0"
                                               Style="{StaticResource HintTextStyle}"
                                               Text="密码使用 Windows 当前用户加密后保存在本机，仅显示掩码。" />
                                </StackPanel>
                            </Expander>

                            <TextBlock Margin="0,9,0,0"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       FontSize="11"
                                       Text="{Binding PasswordSettingsStatus}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="通用设置 · 输出与执行" />
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="输出方式" />
                            <ComboBox ItemsSource="{Binding OutputModes}" SelectedItem="{Binding SelectedOutputMode}" />

                            <CheckBox Margin="0,10,0,4" IsChecked="{Binding UseCustomOutputDirectory}" Content="使用自定义输出根目录" />
                            <TextBox IsEnabled="{Binding UseCustomOutputDirectory}" Text="{Binding OutputBaseDirectory, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入自定义输出根目录" />

                            <Separator Margin="0,10" Background="#E8EDF4" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="138" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Margin="0" Text="文件冲突处理" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding ConflictPolicies}" SelectedItem="{Binding SelectedConflictPolicy}" />
                            </Grid>

                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Margin="0" Text="并行任务数" />
                                <TextBox Grid.Column="1" Text="{Binding MaxParallelJobsText, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" />
                            </Grid>

                            <Border Margin="0,12,0,0" Padding="10,8" Background="#FFF8ED" BorderBrush="#F7D7A8" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <CheckBox Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" IsChecked="{Binding DeleteSourceAfterSuccess}" Content="成功后删除源压缩文件" />
                                    <TextBlock Margin="22,2,0,0" Foreground="{StaticResource WarningBrush}" FontSize="11" TextWrapping="Wrap" Text="仅在确认解压成功后删除；分卷会作为一组处理。请谨慎启用。" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Row="0" Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" ShowsPreview="True" />

            <Grid Grid.Row="0" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" Text="运行汇总" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding OverallStatus, FallbackValue=等待开始, TargetNullValue=等待开始}" />
                        </Grid>

                        <UniformGrid Grid.Row="1" Columns="6">
                            <Border Margin="0,0,6,0" Padding="8" Background="#F7F9FC" CornerRadius="7">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SummaryValueStyle}" Text="{Binding CurrentPass, FallbackValue=0}" />
                                    <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="当前轮次" />
                                </StackPanel>
                            </Border>
                            <Border Margin="2,0,4,0" Padding="8" Background="#F7F9FC" CornerRadius="7">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SummaryValueStyle}" Text="{Binding ScannedFileCount, FallbackValue=0}" />
                                    <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="已扫描文件" />
                                </StackPanel>
                            </Border>
                            <Border Margin="4,0,2,0" Padding="8" Background="#EFF6FF" CornerRadius="7">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource PrimaryBrush}" Style="{StaticResource SummaryValueStyle}" Text="{Binding DiscoveredJobCount, FallbackValue=0}" />
                                    <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="已发现任务" />
                                </StackPanel>
                            </Border>
                            <Border Margin="4,0,2,0" Padding="8" Background="#F0FDF4" CornerRadius="7">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource SuccessBrush}" Style="{StaticResource SummaryValueStyle}" Text="{Binding CompletedCount, FallbackValue=0}" />
                                    <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="解压成功" />
                                </StackPanel>
                            </Border>
                            <Border Margin="4,0,2,0" Padding="8" Background="#FEF2F2" CornerRadius="7">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource DangerBrush}" Style="{StaticResource SummaryValueStyle}" Text="{Binding FailedCount, FallbackValue=0}" />
                                    <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="失败" />
                                </StackPanel>
                            </Border>
                            <Border Margin="6,0,0,0" Padding="8" Background="#FFF8ED" CornerRadius="7">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource WarningBrush}" Style="{StaticResource SummaryValueStyle}" Text="{Binding IncompleteCount, FallbackValue=0}" />
                                    <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="分卷不完整" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Padding="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" Text="解压任务" />
                                <Border Margin="9,0,0,0" Padding="7,2" Background="#EDF3FB" CornerRadius="10">
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Text="{Binding DiscoveredJobCount, FallbackValue=0}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Margin="0,0,12,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           Text="失败或取消的普通文件可直接重试" />
                                <Button MinWidth="84"
                                        MinHeight="30"
                                        Margin="0,0,7,0"
                                        Padding="10,4"
                                        Command="{Binding CopySelectedPathCommand}"
                                        Content="复制路径"
                                        Style="{StaticResource BaseButtonStyle}"
                                        ToolTip="复制所选任务的源文件路径；分卷任务会复制全部分卷路径" />
                                <Button MinWidth="92"
                                        MinHeight="30"
                                        Padding="10,4"
                                        Command="{Binding RetrySelectedCommand}"
                                        Content="重试选中"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        ToolTip="使用原文件路径和当前密码候选，重新执行失败或取消的普通文件任务" />
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Jobs}"
                                  SelectedItem="{Binding SelectedJob}"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  FrozenColumnCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="压缩包" Width="180" Binding="{Binding DisplayName}" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn Header="状态" Width="82" Binding="{Binding Status}" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn Header="阶段" Width="100" Binding="{Binding Phase}" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn Header="相对目录" Width="170" Binding="{Binding RelativeDirectory}" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn Header="类型" Width="92" Binding="{Binding ArchiveKind}" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn Header="分卷" Width="90" Binding="{Binding VolumeSummary}" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn Header="轮次" Width="65" Binding="{Binding DiscoveryPass}" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTemplateColumn Header="进度" Width="155">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <ProgressBar Height="18" Minimum="0" Maximum="100" Background="#E8EDF4" BorderThickness="0" Foreground="{StaticResource PrimaryBrush}" Value="{Binding ProgressPercent, Mode=OneWay}" />
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" FontSize="10" FontWeight="SemiBold" Text="{Binding ProgressPercent, StringFormat={}{0}%}" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="当前文件" Width="190" Binding="{Binding CurrentFile}" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn Header="输出目录" Width="230" Binding="{Binding OutputDirectory}" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn Header="结果 / 消息" Width="240" Binding="{Binding Message}" ElementStyle="{StaticResource GridTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="1" Grid.ColumnSpan="3" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" ShowsPreview="True" />

            <Border Grid.Row="2" Grid.ColumnSpan="3" Padding="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" Text="运行日志" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="密码内容会自动隐藏" />
                        </StackPanel>
                        <Button Grid.Column="1" MinWidth="92" MinHeight="30" Padding="10,4" Command="{Binding ExportLogCommand}" Content="导出日志..." Style="{StaticResource BaseButtonStyle}" />
                    </Grid>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding LogLines}"
                             Background="#111827"
                             BorderThickness="0"
                             FontFamily="Consolas, Microsoft YaHei UI"
                             FontSize="12"
                             Foreground="#D1D5DB"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,3" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#24324A" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="NoWrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
