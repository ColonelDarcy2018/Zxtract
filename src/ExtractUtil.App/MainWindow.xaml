<Window x:Class="ExtractUtil.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:enums="clr-namespace:ExtractUtil.Core.Enums;assembly=ExtractUtil.Core"
        Title="Zxtract" Icon="Resources/Zxtract.ico" Width="1200" Height="760" MinWidth="1024" MinHeight="640"
        Background="#F7F8FA" FontFamily="Microsoft YaHei UI" FontSize="13"
        AllowDrop="True" PreviewDragOver="OnPreviewDragOver" Drop="OnDrop"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding AddFilesCommand}" />
        <KeyBinding Key="F5" Command="{Binding StartCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding ScanOnlyCommand}" />
        <KeyBinding Key="E" Modifiers="Control+Shift" Command="{Binding ExportLogCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#315EA8" />
        <SolidColorBrush x:Key="PrimarySoftBrush" Color="#EDF3FC" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#202735" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#677180" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#8B94A2" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E3E7EC" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#327154" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B23D35" />

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#CFD5DD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBorder" Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="FocusRing" Margin="-3" CornerRadius="7" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EEF3FA" /><Setter Property="BorderBrush" Value="#A5BAD7" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#DCE7F6" /><Setter Property="BorderBrush" Value="#315EA8" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#274F91" /><Setter Property="BorderBrush" Value="#274F91" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#1D3F78" /><Setter Property="BorderBrush" Value="#1D3F78" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TextButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="MinHeight" Value="32" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E7EFFB" /><Setter Property="BorderBrush" Value="#CADAF0" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#D3E2F7" /><Setter Property="BorderBrush" Value="#A5BAD7" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="#F4F6F8" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#C7D7EE" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="#DCE7F6" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ToggleBorder" Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TopTabItemStyle" TargetType="TabItem">
            <Setter Property="MinWidth" Value="116" /><Setter Property="Height" Value="48" /><Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Padding="{TemplateBinding Padding}" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#F0F4FA" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#E7EFFB" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" /><Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="TabBorder" Property="Background" Value="#EDF3FC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TopTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><TabPanel IsItemsHost="True" /></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FilterItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,6" /><Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chip" Padding="{TemplateBinding Padding}" CornerRadius="5" Background="Transparent"><ContentPresenter /></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="Background" Value="#F0F4FA" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chip" Property="Background" Value="#DCE7F6" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" /><Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SegmentRadioStyle" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="11,5" />
            <Setter Property="Margin" Value="0,0,6,0" /><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Segment" Padding="{TemplateBinding Padding}" Background="#FFFFFF" BorderBrush="#CFD5DD" BorderThickness="1" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Segment" Property="Background" Value="#F0F4FA" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Segment" Property="Background" Value="{StaticResource PrimarySoftBrush}" /><Setter TargetName="Segment" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" /><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Segment" Property="Background" Value="#DCE7F6" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Segment" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" /><Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D7DCE3" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#A5BAD7" /></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="8,4" /></Style>
        <Style x:Key="TaskGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="RowBackground" Value="#FFFFFF" /><Setter Property="AlternatingRowBackground" Value="#FFFFFF" />
            <Setter Property="RowHeight" Value="80" /><Setter Property="ColumnHeaderHeight" Value="38" />
            <Setter Property="HeadersVisibility" Value="Column" /><Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" /><Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" /><Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" /><Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserResizeColumns" Value="False" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="CellStyle" Value="{DynamicResource TaskCellStyle}" />
            <Setter Property="ColumnHeaderStyle" Value="{DynamicResource TaskHeaderStyle}" />
        </Style>
        <Style x:Key="TaskHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F7F8FA" /><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="24,0" /><Setter Property="FontWeight" Value="Normal" /><Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style x:Key="StatusHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource TaskHeaderStyle}"><Setter Property="Padding" Value="16,0" /></Style>
        <Style x:Key="ActionHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource TaskHeaderStyle}"><Setter Property="Padding" Value="12,0" /></Style>
        <Style x:Key="TaskCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="24,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="StatusCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource TaskCellStyle}"><Setter Property="Padding" Value="16,0" /></Style>
        <Style x:Key="ActionCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource TaskCellStyle}"><Setter Property="Padding" Value="12,0" /></Style>
        <Style x:Key="TaskRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridRow">
                <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <DataGridCellsPresenter />
                        <Border x:Name="SelectionMarker" Width="3" HorizontalAlignment="Left" Background="Transparent" IsHitTestVisible="False" />
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionMarker" Property="Background" Value="{StaticResource PrimaryBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding NeedsAttention}" Value="True"><Setter Property="Background" Value="#FFFAF7" /></DataTrigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F3F7FD" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E7EFFB" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#F0F2F5" />
            <Setter Property="CornerRadius" Value="4" /><Setter Property="Padding" Value="8,3" />
            <Setter Property="TextElement.Foreground" Value="#596577" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Background" Value="#EDF3FC" /><Setter Property="TextElement.Foreground" Value="#315EA8" /></DataTrigger>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Background" Value="#EAF5EE" /><Setter Property="TextElement.Foreground" Value="#327154" /></DataTrigger>
                <DataTrigger Binding="{Binding NeedsAttention}" Value="True"><Setter Property="Background" Value="#FBECE7" /><Setter Property="TextElement.Foreground" Value="#A84431" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" />
        </Style>
    </Window.Resources>

    <Grid Background="#F7F8FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="64" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TabControl Grid.Column="0" SelectedIndex="{Binding SelectedWorkflowIndex}" Style="{StaticResource TopTabControlStyle}">
                    <TabItem Header="文件解压" Style="{StaticResource TopTabItemStyle}" />
                    <TabItem Header="文件夹解压" Style="{StaticResource TopTabItemStyle}" />
                </TabControl>
                <Border Grid.Column="1" Margin="20,0" Padding="10,5" CornerRadius="4" VerticalAlignment="Center" HorizontalAlignment="Left" Background="#F0F2F5">
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Text="{Binding SessionStatusText}" />
                </Border>
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding SelectedWorkflowIndex}" Value="1"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <Button Margin="0,0,8,0" Command="{Binding AddFilesCommand}" Content="＋ 添加文件" Style="{StaticResource BaseButtonStyle}" />
                            <Button MinWidth="104" Command="{Binding StartCommand}" Content="开始解压" Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedWorkflowIndex}" Value="1"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <Button Margin="0,0,8,0" Command="{Binding BrowseScanRootCommand}" Content="选择文件夹" Style="{StaticResource BaseButtonStyle}" />
                            <Button MinWidth="122" Command="{Binding ScanAndExtractCommand}" Content="扫描并解压" Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <Button MinWidth="72" Margin="0,0,8,0" Command="{Binding PauseResumeCommand}" Content="{Binding PauseButtonText}" IsEnabled="{Binding CanPause}" Style="{StaticResource BaseButtonStyle}" />
                        <Button MinWidth="72" Command="{Binding CancelCommand}" Content="取消" Style="{StaticResource BaseButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedWorkflowIndex}" Value="1"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
            <Grid Height="48" Margin="24,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Text="当前目录" />
                <TextBlock Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"
                           Text="{Binding ScanRootDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ScanRootDirectory}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Text="包含子文件夹" />
                    <Button Command="{Binding ScanOnlyCommand}" Content="仅扫描" Style="{StaticResource TextButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Background="#F7F8FA">
            <Grid Height="52" Margin="24,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Text="密码" />
                <ToggleButton x:Name="PasswordToggle" Grid.Column="1" Margin="6,0,18,0" Checked="OnPasswordOpened" IsChecked="{Binding IsPasswordPanelOpen, Mode=TwoWay}" Content="{Binding PasswordSummary}" Style="{StaticResource ToggleButtonStyle}" />
                <Border Grid.Column="2" Width="1" Height="20" Margin="0,0,18,0" Background="{StaticResource BorderBrush}" />
                <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Text="输出" />
                <TextBlock Grid.Column="4" Margin="12,0" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding OutputModeDisplay}" />
                <ToggleButton x:Name="OptionsToggle" Grid.Column="5" Checked="OnOptionsOpened" Content="更多选项" Style="{StaticResource ToggleButtonStyle}" />
            </Grid>
            <Border Margin="24,0,24,12" Padding="18">
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=PasswordToggle}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding PasswordPanelTitle}" />
                        <TextBlock Margin="0,4,0,8" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="每行一个，按顺序尝试" />
                        <TextBox Height="76" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding PasswordCandidatesText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="快速复用" />
                        <CheckBox Margin="0,7,0,9" IsChecked="{Binding InferPasswordsFromPath}" Content="从文件名和路径推断密码" />
                        <ItemsControl ItemsSource="{Binding SavedPasswords}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Margin="0,0,7,7" Padding="9,4" Command="{Binding DataContext.UseSavedPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="{Binding MaskedValue}" Style="{StaticResource BaseButtonStyle}" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="18,0,0,0" VerticalAlignment="Bottom">
                        <Button Margin="0,0,0,8" Command="{Binding SaveCandidatePasswordsCommand}" Content="保存到密码库" Style="{StaticResource BaseButtonStyle}" />
                        <Button Margin="0,0,0,8" Command="{Binding ApplyPasswordAndRetryCommand}" Content="应用并重试" Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="{Binding CanApplyPasswordRetry, Converter={StaticResource BoolToVisibility}}" />
                        <Button Click="OnOpenPasswordAssistant" Content="管理密码与规则" Style="{StaticResource TextButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Margin="24,0,24,12" Padding="18">
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=OptionsToggle}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="输出位置" />
                        <WrapPanel>
                            <RadioButton Content="所在目录" IsChecked="{Binding OutputToArchiveDirectory}" Style="{StaticResource SegmentRadioStyle}" />
                            <RadioButton Content="同名子文件夹" IsChecked="{Binding OutputToSubdirectory}" Style="{StaticResource SegmentRadioStyle}" />
                            <RadioButton Content="指定目录" IsChecked="{Binding OutputToCustomRoot}" Style="{StaticResource SegmentRadioStyle}" />
                        </WrapPanel>
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding OutputBaseDirectory, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseCustomOutputDirectory}" /><Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowseOutputCommand}" Content="浏览" Style="{StaticResource BaseButtonStyle}" /></Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="冲突与并行" />
                        <ComboBox ItemsSource="{Binding ConflictPolicies}" SelectedItem="{Binding SelectedConflictPolicy}">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock>
                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Static enums:ConflictPolicy.RenameExisting}"><Setter Property="Text" Value="重命名已有文件" /></DataTrigger>
                                    <DataTrigger Binding="{Binding}" Value="{x:Static enums:ConflictPolicy.Overwrite}"><Setter Property="Text" Value="覆盖已有文件" /></DataTrigger>
                                    <DataTrigger Binding="{Binding}" Value="{x:Static enums:ConflictPolicy.Skip}"><Setter Property="Text" Value="跳过同名文件" /></DataTrigger>
                                </Style.Triggers></Style></TextBlock.Style>
                            </TextBlock></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal"><TextBlock Width="74" VerticalAlignment="Center" Text="并行任务" /><TextBox Width="56" TextAlignment="Center" Text="{Binding MaxParallelJobsText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedWorkflowIndex}" Value="1"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="文件夹模式" />
                        <CheckBox IsChecked="{Binding RecursiveExtractionEnabled}" Content="递归解压嵌套压缩包" />
                        <CheckBox Margin="0,6,0,0" IsChecked="{Binding GroupDistributedVolumes}" Content="跨目录归并分卷" />
                        <CheckBox Margin="0,6,0,0" IsChecked="{Binding DeleteSourceAfterSuccess}" Foreground="{StaticResource DangerBrush}" Content="成功后删除源压缩文件" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                <ListBox SelectedIndex="{Binding SelectedTaskFilterIndex}" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" ItemContainerStyle="{StaticResource FilterItemStyle}">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBoxItem Content="{Binding DataContext.AllFilterText, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    <ListBoxItem Content="{Binding DataContext.RunningFilterText, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    <ListBoxItem Content="{Binding DataContext.AttentionFilterText, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    <ListBoxItem Content="{Binding DataContext.CompletedFilterText, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                </ListBox>
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBox x:Name="JobSearchBox" Padding="10,6,32,6" Text="{Binding JobSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="按文件名或路径搜索" />
                    <TextBlock Margin="11,0,32,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Text="搜索文件名或路径" IsHitTestVisible="False">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding JobSearchText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <Button Content="×" FontSize="16" Width="28" MinHeight="28" Padding="0" Margin="0,0,3,0" HorizontalAlignment="Right" Click="OnClearSearch" ToolTip="清除搜索">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TextButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding JobSearchText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Background="#FFFFFF">
            <DataGrid x:Name="TaskGrid" Style="{StaticResource TaskGridStyle}" RowStyle="{StaticResource TaskRowStyle}" ItemsSource="{Binding FilteredJobs}" SelectedItem="{Binding SelectedJob}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="文件" Width="*" MinWidth="260">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding SourceSummary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceSummary}" />
                            </StackPanel>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="状态 / 进度" Width="260" HeaderStyle="{StaticResource StatusHeaderStyle}" CellStyle="{StaticResource StatusCellStyle}">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <StackPanel VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border HorizontalAlignment="Left" Style="{StaticResource StatusBadgeStyle}"><TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" /></Border>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" FontSize="12" Text="{Binding ProgressText}" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                                <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding StatusDetail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusDetail}">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding StatusDetail}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <ProgressBar Height="4" Margin="0,6,0,0" Minimum="0" Maximum="100" BorderThickness="0" Background="#E1E8F3" Foreground="{StaticResource PrimaryBrush}" Value="{Binding ProgressPercent, Mode=OneWay}" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="操作" Width="224" HeaderStyle="{StaticResource ActionHeaderStyle}" CellStyle="{StaticResource ActionCellStyle}">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <WrapPanel VerticalAlignment="Center">
                                <Button Margin="0,0,4,0" Command="{Binding DataContext.RetryJobCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="{Binding RetryActionText}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource TextButtonStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CanRetry}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Margin="0,0,4,0" Command="{Binding DataContext.OpenJobLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="打开位置"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource TextButtonStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Command="{Binding DataContext.CopyJobPathCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="{Binding CopyActionText}" ToolTip="复制来源路径；分卷任务会复制全部分卷路径">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TextButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsPathCopied}" Value="True"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /><Setter Property="Background" Value="#EAF5EE" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                            </WrapPanel>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding FilteredJobCount}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding EmptyListTitle}" />
                <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Text="{Binding EmptyListHint}" />
            </StackPanel>
        </Grid>

        <Expander Grid.Row="5" Margin="24,8" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Header="任务详情" IsExpanded="False">
            <Expander.Style><Style TargetType="Expander"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding SelectedJob}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Expander.Style>
            <Grid Margin="16,10,16,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding SelectedJob.DisplayName}" /><TextBlock Margin="0,5,0,0" Foreground="{StaticResource TextMutedBrush}" Text="{Binding SelectedJob.ArchivePath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedJob.ArchivePath}" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Foreground="{StaticResource TextMutedBrush}" Text="输出目录" /><TextBlock Margin="0,5,0,0" Text="{Binding SelectedJob.OutputDirectory}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedJob.OutputDirectory}" /></StackPanel>
                <StackPanel Grid.Column="3" Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center"><Button Margin="0,0,8,0" Command="{Binding CopySelectedPathCommand}" Content="复制来源路径" Style="{StaticResource BaseButtonStyle}" /><Button Command="{Binding OpenJobLocationCommand}" CommandParameter="{Binding SelectedJob}" Content="打开所在位置" Style="{StaticResource BaseButtonStyle}" /></StackPanel>
            </Grid>
        </Expander>

        <Border Grid.Row="6" Background="#F7F8FA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding SessionDetailText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SessionDetailText}" /><ToggleButton x:Name="LogToggle" Grid.Column="1" Content="查看日志" Style="{StaticResource ToggleButtonStyle}" /><Button Grid.Column="2" Margin="6,0,0,0" Command="{Binding ExportLogCommand}" Content="导出" Style="{StaticResource TextButtonStyle}" /></Grid>
        </Border>

        <Popup Grid.RowSpan="7" PlacementTarget="{Binding ElementName=LogToggle}" Placement="Top" HorizontalOffset="-720" VerticalOffset="-8"
               IsOpen="{Binding IsChecked, ElementName=LogToggle}" StaysOpen="False" AllowsTransparency="True">
            <Border Width="820" Height="260" Padding="14" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Margin="2,0,0,10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="运行日志" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding LogLines}" Background="#171C24" Foreground="#D7DCE3" BorderThickness="0" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
