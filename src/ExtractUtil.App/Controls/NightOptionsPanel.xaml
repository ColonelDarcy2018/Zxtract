<UserControl x:Class="ExtractUtil.App.Controls.NightOptionsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:enums="clr-namespace:ExtractUtil.Core.Enums;assembly=ExtractUtil.Core" KeyboardNavigation.TabNavigation="Cycle">
    <Border Width="530" Padding="25" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="13">
        <StackPanel>
            <DockPanel><Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="×" Width="28" Padding="0" Style="{StaticResource TextButtonStyle}" Click="OnClose" AutomationProperties.Name="关闭解压设置" /><TextBlock Text="本次解压设置" FontSize="21" VerticalAlignment="Center" /></DockPanel>
            <TextBlock Margin="0,10,0,20" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="设置将用于下一次解压，关闭后自动保留。" /><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Text" Value="本次任务正在运行或暂停中，以下设置暂为只读。" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <StackPanel x:Name="EditableOptions"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="输出位置" FontSize="12" Margin="0,0,0,8" />
                        <ComboBox ItemsSource="{Binding OutputModes}" SelectedItem="{Binding SelectedOutputMode}"><ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Static enums:ArchiveOutputMode.ArchiveDirectory}"><Setter Property="Text" Value="压缩包所在目录" /></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static enums:ArchiveOutputMode.ArchiveSubdirectory}"><Setter Property="Text" Value="同名子文件夹" /></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static enums:ArchiveOutputMode.CustomRoot}"><Setter Property="Text" Value="指定目录" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="同名文件" FontSize="12" Margin="0,0,0,8" /><ComboBox ItemsSource="{Binding ConflictPolicies}" SelectedItem="{Binding SelectedConflictPolicy}"><ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Static enums:ConflictPolicy.RenameExisting}"><Setter Property="Text" Value="重命名已有文件" /></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static enums:ConflictPolicy.Overwrite}"><Setter Property="Text" Value="覆盖已有文件" /></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static enums:ConflictPolicy.Skip}"><Setter Property="Text" Value="跳过同名文件" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                </Grid>
                <StackPanel Margin="0,10,0,0" Visibility="{Binding UseCustomOutputDirectory, Converter={StaticResource BoolToVisibility}}"><DockPanel><Button DockPanel.Dock="Right" Content="浏览" Command="{Binding BrowseOutputCommand}" Style="{StaticResource TextButtonStyle}" /><TextBox Text="{Binding OutputBaseDirectory, UpdateSourceTrigger=PropertyChanged}" /></DockPanel><CheckBox Margin="0,8,0,0" Content="保留相对目录" IsChecked="{Binding PreserveRelativeDirectories}" /></StackPanel>
                <Grid Margin="0,18,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="密码来源" FontSize="12" Margin="0,0,0,8" /><CheckBox Content="从文件名和路径推断" IsChecked="{Binding InferPasswordsFromPath}" /><Button HorizontalAlignment="Left" Padding="0,5" Content="候选密码与密码库…" Click="OnPasswords" Style="{StaticResource TextButtonStyle}" FontSize="11" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="同时处理" FontSize="12" Margin="0,0,0,8" /><TextBox Text="{Binding MaxParallelJobsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="并行任务数量" /></StackPanel>
                </Grid>
                <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedWorkflowIndex}" Value="1"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <CheckBox Content="继续解压嵌套压缩包" IsChecked="{Binding RecursiveExtractionEnabled}" /><TextBlock Margin="24,5,0,15" Text="发现解压结果中的压缩包后，继续加入队列。" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <CheckBox Content="跨目录归并分卷" IsChecked="{Binding GroupDistributedVolumes}" /><TextBlock Margin="24,5,0,15" Text="将不同文件夹中的同组分卷一起处理。" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <CheckBox Content="成功后删除源压缩文件" IsChecked="{Binding DeleteSourceAfterSuccess}" /><TextBlock Margin="24,5,0,0" Text="仅在解压成功后删除，失败时保留原文件。" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
            <Button HorizontalAlignment="Right" Margin="0,24,0,0" MinWidth="72" Content="关闭" Style="{StaticResource PrimaryButtonStyle}" Click="OnClose" />
        </StackPanel>
    </Border>
</UserControl>
