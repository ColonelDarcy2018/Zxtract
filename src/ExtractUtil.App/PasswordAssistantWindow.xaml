<Window x:Class="ExtractUtil.App.PasswordAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zxtract · 密码与规则"
        Icon="Resources/Zxtract.ico"
        Width="680"
        Height="560"
        MinWidth="580"
        MinHeight="480"
        Background="#F4F7FB"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#172033" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5F6B7A" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#8A94A3" />
        <SolidColorBrush x:Key="BorderBrush" Color="#DCE3ED" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="13,6" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="Background" Value="#FEF3F2" />
            <Setter Property="BorderBrush" Value="#F7C9C5" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="MinWidth" Value="126" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,16" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="SemiBold" Text="密码助手" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="集中管理可复用密码和路径推断规则；本次候选仍在主窗口顶部编辑。" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="16,14,16,10" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}">
            <TabItem Header="本地密码库">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="0,0,0,12" Padding="12,10" Background="#EFF6FF" CornerRadius="7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Text="保存本次候选密码" />
                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="自动去重，并使用 Windows 当前用户加密保存。" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    MinWidth="128"
                                    Command="{Binding SaveCandidatePasswordsCommand}"
                                    Content="保存当前候选"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1"
                             Margin="0,0,0,12"
                             ItemsSource="{Binding SavedPasswords}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding MaskedValue}" />
                                    <Button Grid.Column="1"
                                            MinHeight="30"
                                            Margin="8,0,6,0"
                                            Padding="11,4"
                                            Command="{Binding DataContext.UseSavedPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Content="加入本次候选"
                                            Style="{StaticResource BaseButtonStyle}" />
                                    <Button Grid.Column="2"
                                            MinHeight="30"
                                            Padding="11,4"
                                            Command="{Binding DataContext.DeleteSavedPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Content="删除"
                                            Style="{StaticResource DangerButtonStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding NewSavedPassword, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="输入一个要保存到本机密码库的密码" />
                        <Button Grid.Column="1"
                                MinWidth="88"
                                Margin="8,0,0,0"
                                Command="{Binding AddSavedPasswordCommand}"
                                Content="保存密码"
                                Style="{StaticResource BaseButtonStyle}" />
                    </Grid>

                    <TextBlock Grid.Row="3"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               Text="密码只显示掩码；加密内容保存在本机，不会写入运行日志。" />
                </Grid>
            </TabItem>

            <TabItem Header="路径推断规则">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0"
                              Margin="0,0,0,12"
                              FontWeight="SemiBold"
                              IsChecked="{Binding InferPasswordsFromPath}"
                              Content="解压时从文件夹和文件名自动推断密码" />

                    <Border Grid.Row="1" Margin="0,0,0,12" Padding="12,10" Background="#F7F9FC" CornerRadius="7">
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="内置规则始终保留：解压密码、密码、p、pass、password、pwd。自定义规则每行一条，必须包含 {password}，例如：提取码：{password}" />
                    </Border>

                    <TextBox Grid.Row="2"
                             MinHeight="170"
                             AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding CustomPasswordRulesText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="每行一条，例如：口令={password}" />

                    <TextBlock Grid.Row="3"
                               Margin="0,8,0,8"
                               Foreground="{StaticResource PrimaryBrush}"
                               FontSize="11"
                               Text="{Binding PasswordSettingsStatus}" />

                    <Button Grid.Row="4"
                            HorizontalAlignment="Right"
                            MinWidth="150"
                            Command="{Binding SavePasswordRulesCommand}"
                            Content="保存推断规则"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Padding="16,10" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Button HorizontalAlignment="Right" MinWidth="88" Click="OnClose" Content="关闭" IsCancel="True" Style="{StaticResource BaseButtonStyle}" />
        </Border>
    </Grid>
</Window>
