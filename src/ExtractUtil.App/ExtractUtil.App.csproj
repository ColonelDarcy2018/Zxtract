<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>Zxtract</AssemblyName>
    <Product>Zxtract</Product>
    <Title>Zxtract</Title>
    <Description>A focused Windows archive extraction workbench.</Description>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <ApplicationIcon>Resources\Zxtract.ico</ApplicationIcon>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\Zxtract.ico" />
    <Resource Include="Resources\Zxtract.png" />
    <Resource Include="Resources\ink-wash.png" />
    <Resource Include="Resources\night-clear-plate.png" />
    <Resource Include="Resources\night-moon-source.png" />
    <Resource Include="Resources\paper-sky.jpg" />
    <Resource Include="Resources\paper-full.jpg" />
    <Resource Include="Resources\aurora-sky.jpg" />
    <Resource Include="Resources\aurora-full.jpg" />
    <Resource Include="Resources\stone-sky.jpg" />
    <Resource Include="Resources\stone-full.jpg" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExtractUtil.Core\ExtractUtil.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\\..\\tools\\7zip\\7z.exe')">
    <None Include="..\\..\\tools\\7zip\\7z.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

  <ItemGroup Condition="Exists('..\\..\\tools\\7zip\\7z.dll')">
    <None Include="..\\..\\tools\\7zip\\7z.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\\..\\LICENSE" Link="LICENSE.txt">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
    <None Include="..\\..\\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
    <None Include="..\\..\\licenses\\7-Zip-License.txt" Link="licenses\\7-Zip-License.txt">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>
</Project>
