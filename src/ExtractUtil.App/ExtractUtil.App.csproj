<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>Zxtract</AssemblyName>
    <Product>Zxtract</Product>
    <Title>Zxtract</Title>
    <Description>A focused Windows archive extraction workbench.</Description>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <ApplicationIcon>Resources\Zxtract.ico</ApplicationIcon>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\Zxtract.ico" />
    <Resource Include="Resources\Zxtract.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExtractUtil.Core\ExtractUtil.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\\..\\tools\\7zip\\7z.exe')">
    <None Include="..\\..\\tools\\7zip\\7z.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup Condition="Exists('..\\..\\tools\\7zip\\7z.dll')">
    <None Include="..\\..\\tools\\7zip\\7z.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
